# Public (client)
# Site origin for QR codes on share cards (defaults to https://luxe-studio-nb.vercel.app)
# NEXT_PUBLIC_SITE_URL=https://luxe-studio-nb.vercel.app
NEXT_PUBLIC_FORMSPREE_ID=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Admin dashboard login (client-side gate — set in Vercel env vars and redeploy)
NEXT_PUBLIC_ADMIN_PASSWORD=

# Server only — copy to Vercel → Settings → Environment Variables
# Sheet ID only (from URL: .../d/THIS_ID/edit). Watch I vs l in the ID.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional tab name (defaults to first tab / Sheet1)
# GOOGLE_SHEET_TAB_NAME=Sheet1
